# Vertex AI project/region. Required by the Python CLI's ingest and ask commands,
# and by the TypeScript services only when DISPATCH_MODE=cloud-tasks.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1 # Cloud Tasks queue region for the TypeScript services; bootstrap.sh defaults to asia-south1

# Tell google-genai to talk to Vertex AI rather than the Gemini Developer API.
GOOGLE_GENAI_USE_VERTEXAI=true

# Auth: leave unset to use `gcloud auth application-default login`,
# or point at a service account key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Model used for extraction and Q&A. Override if this is deprecated by the
# time you run this — check the Vertex AI Model Garden for current IDs.
GEMINI_MODEL=gemini-2.5-pro

# ---- TypeScript services (apps/api, apps/worker) ----
NODE_ENV=development
DATABASE_URL=postgres://maester:maester@localhost:5433/maester
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# Where uploaded documents are kept. `disk` keeps them on the local filesystem
# and needs no Google Cloud account; the API serves signed upload and download
# URLs itself. Env validation refuses `disk` when NODE_ENV=production.
STORAGE_DRIVER=disk
# Relative to each service's own directory, so ../../data/blobs puts the API
# and the worker on one shared folder at the repository root. Docker Compose
# sets its own path and mounts a shared volume there instead.
STORAGE_DIR=../../data/blobs
# Only read when STORAGE_DRIVER=gcs.
# GCS_BUCKET=your-private-dev-bucket

DISPATCH_MODE=local
DISPATCH_SECRET=local-dispatch-secret
WORKER_URL=http://localhost:8788
# GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION above are shared with the TypeScript
# services and are only required when DISPATCH_MODE=cloud-tasks (queue region =
# GOOGLE_CLOUD_LOCATION).
# Ports: the servers read PORT. Run `PORT=8787 pnpm dev:api` and `PORT=8788 pnpm dev:worker`.
