# Vertex AI project/region. Required by the Python CLI's ingest and ask commands,
# by the extractor (apps/extractor), and by the TypeScript services only when
# DISPATCH_MODE=cloud-tasks.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1 # Cloud Tasks queue region for the TypeScript services; bootstrap.sh defaults to asia-south1

# Tell google-genai to talk to Vertex AI rather than the Gemini Developer API.
GOOGLE_GENAI_USE_VERTEXAI=true

# Auth: leave unset to use `gcloud auth application-default login`,
# or point at a service account key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Model used for extraction and Q&A. Override if this is deprecated by the
# time you run this — check the Vertex AI Model Garden for current IDs.
GEMINI_MODEL=gemini-2.5-pro

# ---- TypeScript services (apps/api, apps/worker) ----
NODE_ENV=development
DATABASE_URL=postgres://maester:maester@localhost:5433/maester
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# The browser's origin, not the API's: `pnpm --dir apps/web dev` proxies /api/auth,
# /v1 and /dev to the API on :8787.
BETTER_AUTH_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Google sign-in. Create an OAuth client (Web application) with the redirect URI
# http://localhost:5173/api/auth/callback/google. Leave both unset to run without it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Confirmation and password-reset mail. `console` logs each message (with its link)
# and is refused in production; `resend` sends through Resend.
MAIL_DRIVER=console
# RESEND_API_KEY=
# MAIL_FROM=Maester <hello@your-domain.example>

# Where uploaded documents are kept. `disk` keeps them on the local filesystem
# and needs no Google Cloud account; the API serves signed upload and download
# URLs itself. Env validation refuses `disk` when NODE_ENV=production.
STORAGE_DRIVER=disk
# Relative to each service's own directory, so ../../data/blobs puts the API
# and the worker on one shared folder at the repository root. Docker Compose
# sets its own path and mounts a shared volume there instead.
STORAGE_DIR=../../data/blobs
# Only read when STORAGE_DRIVER=gcs.
# GCS_BUCKET=your-private-dev-bucket

# `queue`: the worker pulls jobs from Postgres and the API wakes it with NOTIFY.
# `cloud-tasks`: Cloud Tasks pushes each job to the worker's /tasks route.
DISPATCH_MODE=queue
# Jobs of one type a worker runs at once, over the defaults
# (document.verify=4, document.classify=2, document.extract=2).
# JOB_CONCURRENCY=document.extract=3,document.verify=8
WORKER_URL=http://localhost:8788
# GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION above are shared with the TypeScript
# services and are only required when DISPATCH_MODE=cloud-tasks (queue region =
# GOOGLE_CLOUD_LOCATION).
# Ports: the servers read PORT. Run `PORT=8787 pnpm dev:api` and `PORT=8788 pnpm dev:worker`.

# Classification and fact extraction. The worker sends document.classify and
# document.extract jobs to apps/extractor (`uv run --locked maester-extractor`,
# port 8790). Without EXTRACTOR_URL, uploads are verified but classification
# fails (CLASSIFIER_NOT_CONFIGURED). The secret must match on both.
EXTRACTOR_URL=http://localhost:8790
EXTRACTOR_SECRET=local-extractor-secret
# Seconds one extraction request may take (default 1800, thirty minutes).
# EXTRACT_TIMEOUT_SECONDS=1800
# The extractor calls Gemini on Vertex AI with GOOGLE_CLOUD_PROJECT above and
# Application Default Credentials (gcloud auth application-default login).
# VERTEX_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-pro
# Model that works out what an uploaded PDF is before it is read.
# GEMINI_CLASSIFY_MODEL=gemini-2.5-flash
# For docker compose only: the absolute path of your gcloud config directory,
# mounted read-only into the extractor container.
# GCLOUD_CONFIG_DIR=/Users/you/.config/gcloud

# Market mood. CONNECTIONS_KEY encrypts the Dhan and FRED keys you save in Settings, and
# turns on the worker's refresh. Generate with: openssl rand -base64 32
CONNECTIONS_KEY=
# Dhan Data API calls per second (the limit is 5) and minutes between refreshes.
# DHAN_REQUESTS_PER_SECOND=4
# MARKET_REFRESH_MINUTES=30
# Run one pass by hand: pnpm --filter @maester/worker market:refresh

# ---- Indexing and search (apps/indexer, the embedder) ----
# The worker streams each stored PDF to the indexer (`uv run --locked maester-indexer`,
# port 8791) and embeds the chunks with the embedder (text-embeddings-inference, port 8792
# in Docker). Unset INDEXER_URL or EMBEDDER_URL: document.index fails INDEXER_NOT_CONFIGURED.
# INDEXER_SECRET is required when INDEXER_URL is set, and must match on both sides.
# INDEXER_URL=http://localhost:8791
# INDEXER_SECRET=local-indexer-secret
# The API embeds search queries with the same embedder; without EMBEDDER_URL, search says 503.
# EMBEDDER_URL=http://localhost:8792
# EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
# Pages the indexer reads in one request (default 20) and seconds one request may take (default 7200).
# INDEX_PAGE_RANGE=20
# INDEX_TIMEOUT_SECONDS=7200
# Chunks sent to the embedder in one request (default 16).
# EMBED_BATCH=16
# Pages of one document that may be read with OCR (default 400; 0 turns OCR off).
# OCR_PAGE_BUDGET=400
# Indexer settings (read by apps/indexer itself): INDEX_THREADS=6, INDEX_PAGE_BATCH=4,
# INDEX_MAX_BYTES=52428800, DOCLING_ARTIFACTS_PATH and INDEX_TOKENIZER_PATH (folders made by
# `maester-indexer-fetch-models`). In Docker, compose sets them.
# Run `docker compose --profile setup run --rm models` once to fetch the weights.
# Index every stored document that has no current index:
#   pnpm --filter @maester/worker index:backfill [--workspace <id>] [--document <id>]... [--dry-run]
