# Vertex AI project/region. Required.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Tell google-genai to talk to Vertex AI rather than the Gemini Developer API.
GOOGLE_GENAI_USE_VERTEXAI=true

# Auth: leave unset to use `gcloud auth application-default login`,
# or point at a service account key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Model used for extraction and Q&A. Override if this is deprecated by the
# time you run this — check the Vertex AI Model Garden for current IDs.
GEMINI_MODEL=gemini-2.5-pro
