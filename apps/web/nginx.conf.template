server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Re-resolve the API host; Cloud Run addresses change.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    # Auth, API and dev routes go to the API so the session cookie is first-party.
    # A variable upstream makes nginx resolve at request time and pass the URI as is.
    location ~ ^/(api/auth|v1|dev)/ {
        set $api_upstream ${API_PROXY_TARGET};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${API_PROXY_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        # Signed local blob uploads (PUT /dev/blobs/*) pass through here; the API's
        # MAX_UPLOAD_BYTES is 50 MB. Stream them instead of spooling to disk.
        client_max_body_size 50m;
        proxy_request_buffering off;
        # Job progress is Server-Sent Events: no buffering, long reads.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # SvelteKit's static adapter emits /login as login.html (trailingSlash: never).
    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }

    error_page 404 /404.html;
}
