{
  "families": {
    "in-capmkt": {
      "namespace": "^http://www\\.sebi\\.gov\\.in/xbrl/\\d{4}-\\d{2}-\\d{2}/in-capmkt$",
      "rounding_element": "LevelOfRounding"
    },
    "in-bse-fin": {
      "namespace": "^http://www\\.bseindia\\.com/xbrl/fin/\\d{4}-\\d{2}-\\d{2}/in-bse-fin$",
